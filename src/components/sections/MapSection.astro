---
import { Icon } from "astro-icon/components";
import venueData from "~/content/settings/venues.json";

interface Location {
  name: string;
  url: string;
}

interface Venue {
  name: string;
  address: string;
  category?: string;
  lat?: number;
  lng?: number;
}

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
  locations?: (string | Location)[]; // Service-area pills above the map
  venues?: Venue[]; // "Our Locations" panel; defaults to settings/venues.json
  mapUrl?: string;
  viewMode?: "half" | "full";
  background?: "white" | "gradient" | "primary";
}

const {
  title,
  description,
  eyebrow,
  locations = [],
  venues = venueData.venues,
  mapUrl = venueData.mapUrl,
  background = "white",
} = Astro.props;

const bgClass = background === "white" ? "bg-white" : background === "primary" ? "bg-primary" : "bg-neutral";
const onDark = background === "primary";

// Normalize locations to always have name and url
const normalizedLocations = locations.map((loc) => {
  if (typeof loc === "string") {
    return { name: loc, url: null };
  }
  return loc;
});

// With service-area pills, the eyebrow becomes the divider label above them.
const eyebrowInHeader = eyebrow && normalizedLocations.length === 0;

const venueMapsUrl = (v: Venue) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${v.name}, ${v.address}`)}`;
---

<section class={`py-16 md:py-24 ${bgClass} fade-in-section`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    {
      (title || description) && (
        <div class="text-center mb-12">
          {eyebrowInHeader && (
            <div class={`inline-flex items-center gap-2 px-4 py-2 rounded-full mb-4 ${onDark ? "bg-white/10 border border-white/20" : "bg-primary/5 border border-primary-light/30"}`}>
              <span class={`w-2 h-2 rounded-full ${onDark ? "bg-white" : "bg-primary-light"}`} />
              <span class={`text-sm font-semibold ${onDark ? "text-white" : "text-primary"}`}>{eyebrow}</span>
            </div>
          )}
          {title && (
            <h2 class={`section-title mb-6 ${onDark ? "text-white" : "text-primary"}`}>
              {title}
            </h2>
          )}
          {description && (
            <p
              class={`section-description max-w-3xl mx-auto ${onDark ? "text-white/90" : "text-primary-dark"}`}
              set:html={description}
            />
          )}
        </div>
      )
    }

    <!-- Service Areas -->
    {
      normalizedLocations.length > 0 && (
        <div class="mb-8">
          <div class="flex items-center gap-4 mb-5">
            <span class={`h-px w-10 ${onDark ? "bg-white/60" : "bg-primary-light"}`} />
            <span class={`section-eyebrow ${onDark ? "text-white" : "text-primary-light"}`}>
              {eyebrow || "Service Areas"}
            </span>
            <span class={`h-px flex-1 ${onDark ? "bg-white/20" : "bg-gray-200"}`} />
          </div>
          <ul class="flex flex-wrap gap-3">
            {normalizedLocations.map((location) => {
              const pill = `inline-flex items-center px-5 py-2.5 rounded-full border-2 text-sm sm:text-base font-bold transition-colors duration-200 ${
                onDark
                  ? "border-white/30 text-white"
                  : "border-primary-light/40 text-primary-dark"
              }`;
              return (
                <li>
                  {location.url ? (
                    <a
                      href={location.url}
                      class={`${pill} ${onDark ? "hover:bg-white hover:text-primary" : "hover:bg-primary hover:border-primary hover:text-white"}`}
                    >
                      {location.name}
                    </a>
                  ) : (
                    <span class={pill}>{location.name}</span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )
    }

    <!-- Map and Venues Side by Side -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Map - Left Side (2/3 width) -->
      <div class={venues.length > 0 ? "lg:col-span-2" : "lg:col-span-3"}>
        <div class="h-[450px] lg:h-[600px] rounded-2xl overflow-hidden shadow-xl border border-gray-200">
          <iframe
            src={mapUrl}
            class="w-full h-full"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Map of our venue partner locations"></iframe>
        </div>
      </div>

      <!-- Venues - Right Side (1/3 width) -->
      {
        venues.length > 0 && (
          <div class="lg:col-span-1">
            <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden h-[500px] lg:h-[600px] flex flex-col">
              {/* Header */}
              <div class="bg-primary-dark px-6 py-5">
                <h3 class="text-xl font-bold text-white">{venueData.title}</h3>
                <p class="text-sm text-white/80 mt-1">{venueData.subtitle}</p>
              </div>

              {/* Scrollable Venue List */}
              <ul class="flex-1 overflow-y-auto p-4 space-y-3 scrollbar-thin">
                {venues.map((venue) => (
                  <li>
                    <a
                      href={venueMapsUrl(venue)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex items-center gap-3 w-full bg-white border-2 border-gray-200 hover:border-primary-light rounded-xl p-4 text-left shadow-sm hover:shadow-md transition-all duration-200"
                    >
                      <span class="flex-shrink-0 w-10 h-10 bg-primary-dark rounded-lg flex items-center justify-center">
                        <Icon name="tabler:map-pin" class="w-5 h-5 text-white" aria-hidden="true" />
                      </span>
                      <span class="flex-1 min-w-0">
                        <span class="block text-sm font-bold text-primary-dark leading-snug">
                          {venue.name}
                        </span>
                        <span class="block text-xs text-gray-500 mt-0.5 leading-snug">
                          {venue.address}
                        </span>
                      </span>
                      <Icon
                        name="tabler:chevron-right"
                        class="w-5 h-5 flex-shrink-0 text-primary-light transition-transform group-hover:translate-x-1"
                        aria-hidden="true"
                      />
                      <span class="sr-only">(opens Google Maps in a new tab)</span>
                    </a>
                  </li>
                ))}
              </ul>

              {/* Footer Info */}
              <div class="bg-gray-50 px-6 py-4 border-t border-gray-200">
                <p class="flex items-center gap-2 text-xs text-primary-dark">
                  <Icon name="tabler:info-circle-filled" class="w-5 h-5 text-primary-light flex-shrink-0" aria-hidden="true" />
                  Click any location to open in Google Maps
                </p>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
