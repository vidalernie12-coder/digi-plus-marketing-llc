---
interface GalleryImage {
  src: string;
  alt: string;
  label?: string;
  link?: string;
  description?: string;
}

interface Props {
  title?: string;
  eyebrow?: string;
  description?: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  image?: string;
  galleryImages?: GalleryImage[];
}

const {
  title,
  eyebrow,
  description,
  ctaText,
  ctaLink,
  secondaryCtaText,
  secondaryCtaLink,
  image,
  galleryImages = [],
} = Astro.props;

// The gallery only shows from lg up, so below that the text is the last thing
// in the hero; reserve the gallery's spacing for lg+ to avoid an empty gap.
const hasGallery = galleryImages.length > 0;
const hasCta = Boolean((ctaText && ctaLink) || (secondaryCtaText && secondaryCtaLink));
// Below lg the hero is only text, so give it a viewport-based min height
// (content is vertically centered) instead of collapsing to a thin strip.
---

<section
  class={`${hasGallery ? "pb-12 sm:pb-16 lg:pb-20" : "pb-12 md:pb-20"} relative overflow-hidden -mt-16 sm:-mt-24 pt-28 sm:pt-40 min-h-[65svh] md:min-h-[50svh] lg:min-h-0 flex flex-col justify-center`}
>
  <!-- Brand gradient background (soft lavender + warm orange glow) with slowly
       drifting color blobs - extends behind navbar -->
  <div class="hero-bg absolute inset-0 top-[-64px] sm:top-[-96px] -z-10" aria-hidden="true">
    <span class="hero-blob hero-blob--purple"></span>
    <span class="hero-blob hero-blob--orange"></span>
    <span class="hero-blob hero-blob--lavender"></span>
  </div>

  <div class={`max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative ${hasGallery ? "lg:mb-12" : "mb-8 md:mb-12"}`}>
    <!-- Content -->
    <div class={hasGallery ? "lg:pb-12" : "pb-6 sm:pb-8 md:pb-12"}>
      <div class="max-w-4xl text-center mx-auto">
        {
          eyebrow && (
            <div class="inline-block mb-4 px-4 py-2 bg-white/50 backdrop-blur-sm rounded-full border border-primary-light/30">
              <span class="text-xs sm:text-sm font-semibold text-primary uppercase tracking-wider">
                {eyebrow}
              </span>
            </div>
          )
        }

        {
          title && (
            <h1 class="text-4xl sm:text-5xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-4 sm:mb-6 leading-tight">
              {title}
            </h1>
          )
        }

        {
          description && (
            <p class={`text-base sm:text-lg md:text-xl text-gray-600 leading-relaxed max-w-2xl mx-auto ${hasCta ? "mb-8 sm:mb-10" : ""}`}>
              {description}
            </p>
          )
        }

        {
          (ctaText || secondaryCtaText) && (
            <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4 justify-center">
              {ctaText && ctaLink && (
                <a
                  href={ctaLink}
                  class="cta-button inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3 sm:py-4 bg-primary-dark text-white text-sm sm:text-base font-bold rounded-full hover:bg-primary-darker leading-tight text-center"
                >
                  <span>{ctaText}</span>
                  <svg
                    class="w-4 h-4 sm:w-5 sm:h-5 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 8l4 4m0 0l-4 4m4-4H3"
                    />
                  </svg>
                </a>
              )}
              {secondaryCtaText && secondaryCtaLink && (
                <a
                  href={secondaryCtaLink}
                  class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3 sm:py-4 bg-white/50 backdrop-blur-sm text-primary text-sm sm:text-base font-bold rounded-full border-2 border-primary-light hover:border-primary hover:bg-white/70 transition-all duration-300 shadow-md hover:shadow-lg hover:scale-105 hover:-translate-y-0.5 active:scale-100 active:translate-y-0"
                >
                  {secondaryCtaText}
                </a>
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>

  <!-- Sliding Image Gallery -->
  {
    galleryImages && galleryImages.length > 0 && (
      <div class="gallery-mask hidden lg:block overflow-hidden relative">
        <div class="gallery-track">
          <div class="gallery-slide">
            {galleryImages.map((img) => (
              <div class="gallery-item">
                {img.link ? (
                  <a
                    href={img.link}
                    class="block relative h-48 sm:h-56 md:h-64 rounded-2xl overflow-hidden group shadow-xl hover:shadow-2xl transition-all duration-700 ease-out transform"
                  >
                    <img
                      src={img.src}
                      alt={img.alt}
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 z-10 bg-slate-900/40 group-hover:bg-slate-900/80 group-hover:backdrop-blur-sm transition-all duration-700 ease-in-out" />
                    <div class="absolute inset-0 z-20 flex flex-col justify-end p-4 text-white">
                      {img.label && (
                        <p class="text-base md:text-lg font-bold mb-2 transition-all duration-700 ease-out transform group-hover:translate-y-[-4px]">
                          {img.label}
                        </p>
                      )}
                      {img.description && (
                        <div class="overflow-hidden transition-all duration-700 ease-out max-h-0 group-hover:max-h-48 transform">
                          <p class="text-xs md:text-sm leading-relaxed opacity-0 group-hover:opacity-100 transition-all duration-700 delay-150 ease-out transform translate-y-2 group-hover:translate-y-0">
                            {img.description}
                          </p>
                        </div>
                      )}
                    </div>
                  </a>
                ) : (
                  <div class="relative h-48 sm:h-56 md:h-64 rounded-2xl overflow-hidden group shadow-xl">
                    <img
                      src={img.src}
                      alt={img.alt}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 z-10 bg-slate-900/40" />
                    <div class="absolute inset-0 z-20 flex flex-col justify-end p-4 text-white">
                      {img.label && (
                        <p class="text-base md:text-lg font-bold">
                          {img.label}
                        </p>
                      )}
                    </div>
                  </div>
                )}
              </div>
            ))}
          </div>
          <div class="gallery-slide" aria-hidden="true">
            {galleryImages.map((img) => (
              <div class="gallery-item">
                {img.link ? (
                  <a
                    href={img.link}
                    class="block relative h-48 sm:h-56 md:h-64 rounded-2xl overflow-hidden group shadow-xl hover:shadow-2xl transition-all duration-700 ease-out transform hover:-translate-y-1"
                  >
                    <img
                      src={img.src}
                      alt={img.alt}
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 z-10 bg-slate-900/40 group-hover:bg-slate-900/80 group-hover:backdrop-blur-sm transition-all duration-700 ease-in-out" />
                    <div class="absolute inset-0 z-20 flex flex-col justify-end p-4 text-white">
                      {img.label && (
                        <p class="text-base md:text-lg font-bold mb-2 transition-all duration-700 ease-out transform group-hover:translate-y-[-4px]">
                          {img.label}
                        </p>
                      )}
                      {img.description && (
                        <div class="overflow-hidden transition-all duration-700 ease-out max-h-0 group-hover:max-h-48 transform">
                          <p class="text-xs md:text-sm leading-relaxed opacity-0 group-hover:opacity-100 transition-all duration-700 delay-150 ease-out transform translate-y-2 group-hover:translate-y-0">
                            {img.description}
                          </p>
                        </div>
                      )}
                    </div>
                  </a>
                ) : (
                  <div class="relative h-48 sm:h-56 md:h-64 rounded-2xl overflow-hidden group shadow-xl">
                    <img
                      src={img.src}
                      alt={img.alt}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 z-10 bg-slate-900/40" />
                    <div class="absolute inset-0 z-20 flex flex-col justify-end p-4 text-white">
                      {img.label && (
                        <p class="text-base md:text-lg font-bold">
                          {img.label}
                        </p>
                      )}
                    </div>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    )
  }
</section>

<style>
  .cta-button {
    transform: scale(1);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), 
                background-color 0.25s ease, 
                box-shadow 0.25s ease,
                border-color 0.25s ease;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-transform: translateZ(0) scale(1);
    transform: translateZ(0) scale(1);
  }

  .cta-button::before {
    display: none !important;
  }

  /* Hero background: layered brand-tinted gradients instead of flat white */
  .hero-bg {
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 55% at 8% 0%, rgba(75, 46, 92, 0.14), transparent 70%),
      radial-gradient(ellipse 55% 50% at 95% 10%, rgba(223, 124, 70, 0.16), transparent 70%),
      linear-gradient(180deg, #faf6fc 0%, #f4ecf8 55%, #fbf1ea 100%);
  }

  .hero-blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(70px);
    opacity: 0.55;
    will-change: transform;
    animation: hero-drift 22s ease-in-out infinite alternate;
  }

  .hero-blob--purple {
    width: 34rem;
    height: 34rem;
    left: -10rem;
    top: 2rem;
    background: #c9b3d8;
  }

  .hero-blob--orange {
    width: 28rem;
    height: 28rem;
    right: -8rem;
    top: 6rem;
    background: #f7c6a4;
    animation-duration: 26s;
    animation-delay: -6s;
  }

  .hero-blob--lavender {
    width: 30rem;
    height: 30rem;
    left: 35%;
    bottom: -14rem;
    background: #e3d3ee;
    animation-duration: 30s;
    animation-delay: -12s;
  }

  @media (max-width: 767px) {
    .hero-blob {
      filter: blur(50px);
    }
    .hero-blob--purple {
      width: 20rem;
      height: 20rem;
      left: -8rem;
    }
    .hero-blob--orange {
      width: 16rem;
      height: 16rem;
      right: -6rem;
    }
    .hero-blob--lavender {
      width: 18rem;
      height: 18rem;
      left: 20%;
      bottom: -8rem;
    }
  }

  @keyframes hero-drift {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(3rem, -2rem, 0) scale(1.08);
    }
    100% {
      transform: translate3d(-2rem, 2rem, 0) scale(0.95);
    }
  }

  /* Fade the gallery edges into whatever is behind it */
  .gallery-mask {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .cta-button:hover {
    -webkit-transform: translateZ(0) scale(1.05);
    transform: translateZ(0) scale(1.05);
  }

  .cta-button:active {
    -webkit-transform: translateZ(0) scale(1);
    transform: translateZ(0) scale(1);
  }

  /*
   * Seamless marquee: the track holds two identical slides.
   * Every item — including each slide's last — carries the SAME trailing
   * space via `margin-right`, so there is no larger gap at the seam and
   * both slides are exactly equal width. With no slide-level gap/padding,
   * translateX(-50%) lands item-for-item on the duplicate at every
   * breakpoint, and the space at the wrap point matches the space between
   * every other pair of cards.
   */
  .gallery-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: scroll 60s linear infinite;
  }

  .gallery-track:hover {
    animation-play-state: paused;
  }

  .gallery-slide {
    display: flex;
    flex-shrink: 0;
  }

  .gallery-item {
    flex: 0 0 200px;
    margin-right: 1rem;
  }

  @media (min-width: 640px) {
    .gallery-item {
      flex: 0 0 240px;
      margin-right: 1.25rem;
    }
  }

  @media (min-width: 768px) {
    .gallery-item {
      flex: 0 0 260px;
      margin-right: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery-item {
      flex: 0 0 280px;
      margin-right: 1.5rem;
    }
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-track,
    .hero-blob {
      animation: none;
    }
  }
</style>
